{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Django",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": [
                "runserver"
            ],
            "django": true
        },
        {
            "name": "Pytest: Debug current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-q"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "project.settings"
            }
        }
    ]
}